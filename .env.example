# Copia este archivo como ".env" (en la misma carpeta) y rellénalo.
# El archivo .env NO se sube a git.
#
# Solo van aquí cosas PÚBLICAS: la dirección del proyecto de Supabase y su clave
# pública ("Publishable key", empieza por sb_publishable_). Las encuentras en
# supabase.com > tu proyecto > Project Settings > API Keys.
#
# NUNCA pongas aquí la clave de Anthropic ni la clave secreta de Supabase
# (sb_secret_...): esas van solo en los secretos de Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Fase 6 (opcional, solo web): clave PÚBLICA de TomTom para dibujar el mapa y el
# tráfico. Restríngela al dominio en developer.tomtom.com. La de calcular rutas
# (TOMTOM_API_KEY) va solo en los secretos de Supabase, nunca aquí.
EXPO_PUBLIC_TOMTOM_MAPA_KEY=
